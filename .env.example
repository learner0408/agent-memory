# Copy to .env and fill in.
ANTHROPIC_API_KEY=
PINECONE_API_KEY=
# mem0: set False to disable its telemetry (which would also try to create a "mem0migrations" index on your vector DB)
MEM0_TELEMETRY=
# letta app server: the capability token (openssl rand -hex 32); also written to app-server-token for the docker bind-mount
LETTA_APP_SERVER_TOKEN=
